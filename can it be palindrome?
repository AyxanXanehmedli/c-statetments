#include <bits/stdc++.h>
using namespace std;

int main(){
    string s;
    cin >> s;
    int count = 1;
    for(int i = 1; i < s.size(); i++)
    {
        if(s[0] != s[i]) count++;
    }

    bool cvb;
    
    if(s.size() % 2 == 0){
        if(count <= s.size() / 2) cvb = true;
        else cvb = false;
    }
    
    else{
        if(count <= s.size() / 2 + 1) cvb = true;
        else cvb = false;
    }
    
    cout <<(cvb ? "yes" : "no");
}
